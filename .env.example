# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MEDIA STORAGE (Photos & Videos)
# Options: 'telegram' (recommended dual-lane), 'b2', 'r2', 's3', or 'local'
# When STORAGE_BACKEND="telegram", new uploads go to Telegram and existing S3/B2 vars act as read fallback.
STORAGE_BACKEND="telegram"

# TELEGRAM DUAL-LANE STORAGE (NotaForge Architecture)
# Target private Telegram channel ID (add your bot & account as admin; usually starts with -100)
TELEGRAM_CHAT_ID=""

# Lane 1 — Telegram Bot API (Fast uploads <= 15 MB; optional if using MTProto for all files)
TELEGRAM_BOT_TOKEN=""
# Optional: Self-hosted Telegram Bot API Server URL (lifts Bot API limit to 2 GB)
TELEGRAM_API_BASE_URL=""

# Lane 2 — Embedded GramJS MTProto (Files > 15 MB up to 2 GB, 8-worker uploads, HTTP 206 video seeking)
# Get API_ID & API_HASH at https://my.telegram.org, then run: npm run telegram:session
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_SESSION=""

# Optional: External NotaForge standalone telegram-server URL (if not using embedded TELEGRAM_SESSION)
TELEGRAM_MTPROTO_SERVER_URL=""

# BACKBLAZE B2 / S3 (Legacy Read Fallback when STORAGE_BACKEND="telegram", or Primary when STORAGE_BACKEND="b2")
S3_ENDPOINT="s3.us-west-004.backblazeb2.com"
S3_REGION="auto"
S3_BUCKET="my-kinfolk-photos"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# DATABASE PERSISTENCE & TURSO CLOUD
# For permanent cross-deployment storage on Render without a paid disk:
TURSO_DATABASE_URL="libsql://your-database-name-username.turso.io"
TURSO_AUTH_TOKEN=""

# Alternatively, if using a Render Persistent Disk:
# DB_PATH="/var/data/kinfolk.sqlite"
