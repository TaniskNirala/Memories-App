{
  "name": "nest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx tests/run_tests.ts",
    "seed": "tsx scripts/seed.ts",
    "purge:storage": "tsx scripts/purge-storage.ts",
    "telegram:session": "tsx scripts/generate-telegram-session.ts",
    "start": "tsx server.ts",
    "import:turso": "tsx scripts/import-from-turso.ts",
    "check": "npm run lint && npm run lint:hooks && npm run build && npm test && npm run test:ui",
    "lint:hooks": "oxlint -c oxlintrc.json src server server.ts",
    "test:ui": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" server.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@google/genai": "^2.4.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@use-gesture/react": "^10.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.3",
    "big-integer": "^1.6.52",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "libsql": "^0.5.29",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "pg": "^8.13.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "telegram": "^2.26.22",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "vitest": "^5.1.1"
  }
}
