# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MEDIA STORAGE (Photos & Videos)
# Options: 'telegram' (recommended dual-lane), 'b2', 'r2', 's3', or 'local'
# When STORAGE_BACKEND="telegram", new uploads go to Telegram and existing S3/B2 vars act as read fallback.
STORAGE_BACKEND="telegram"

# TELEGRAM DUAL-LANE STORAGE (NotaForge Architecture)
# Target private Telegram channel ID (add your bot & account as admin; usually starts with -100)
TELEGRAM_CHAT_ID=""

# Lane 1 — Telegram Bot API (Fast uploads <= 15 MB; optional if using MTProto for all files)
TELEGRAM_BOT_TOKEN=""
# Optional: Self-hosted Telegram Bot API Server URL (lifts Bot API limit to 2 GB)
TELEGRAM_API_BASE_URL=""

# Lane 2 — Embedded GramJS MTProto (Files > 15 MB up to 2 GB, 8-worker uploads, HTTP 206 video seeking)
# Get API_ID & API_HASH at https://my.telegram.org, then run: npm run telegram:session
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_SESSION=""

# Optional: External NotaForge standalone telegram-server URL (if not using embedded TELEGRAM_SESSION)
TELEGRAM_MTPROTO_SERVER_URL=""

# How often (minutes) Nest checks whether media was deleted from the Telegram channel. 0 disables. Default 5.
TELEGRAM_DELETE_CHECK_MINUTES="5"

# BACKBLAZE B2 / S3 (Legacy Read Fallback when STORAGE_BACKEND="telegram", or Primary when STORAGE_BACKEND="b2")
S3_ENDPOINT="s3.us-west-004.backblazeb2.com"
S3_REGION="auto"
S3_BUCKET="my-kinfolk-photos"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# DATABASE (Neon PostgreSQL) - REQUIRED in production
# Neon is the permanent source of truth: all users, posts, photo/video records, circles, comments and
# login sessions are stored there. Tables are created AUTOMATICALLY on every boot - nothing to run by hand.
# Get the string from Neon dashboard -> your project -> Connect -> "Connection string"
# (either the direct or the pooled string works; keep ?sslmode=require at the end).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Optional: only for the one-time `npm run import:turso` script (copy old Turso data into Neon)
# TURSO_DATABASE_URL=""
# TURSO_AUTH_TOKEN=""

# --- SECURITY (required / recommended for production) ---
# REQUIRED in production: random string, 32+ characters (e.g. `openssl rand -hex 32`). The server will not start without it.
STORAGE_SIGNING_SECRET=""

# Only needed on a brand-new empty database: this username is allowed to become the first admin.
BOOTSTRAP_ADMIN_USERNAME=""

# Optional: extra origins (comma separated) allowed to call the API with cookies. Same-origin and APP_URL are always allowed.
ALLOWED_ORIGINS=""

# Optional: lax (default) | strict | none. Use 'none' only if the app must run in a cross-site iframe.
COOKIE_SAMESITE="lax"

# Optional: origins allowed to embed the app in an iframe (comma separated). Empty = same origin only.
FRAME_ANCESTORS=""

# Optional: number of reverse-proxy hops in front of the app (default 1 in production).
TRUST_PROXY=""

# Optional: per-user upload quota in MB (default 51200, 0 disables).
USER_STORAGE_QUOTA_MB=""

# --- Logging -----------------------------------------------------------------
# debug | info (default) | warn | error | silent
LOG_LEVEL="info"
# text (default) or json (one JSON object per line, easier to search in Render logs)
LOG_FORMAT="text"
